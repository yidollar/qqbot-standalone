{
  "name": "qqbot-standalone",
  "version": "1.0.0",
  "description": "QQ Bot standalone minimal core — extracted from @tencent-connect/openclaw-qqbot without OpenClaw deps",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "qqbot-standalone": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tencent-connect/qqbot-nodejs": "^1.0.4",
    "https-proxy-agent": "^9.1.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
